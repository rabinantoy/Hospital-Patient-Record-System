
import java.util.ArrayList;
import java.util.Scanner;

class Patient {
    int id;
    String name;
    int age;
    String disease;

    Patient(int id, String name, int age, String disease) {
        this.id = id;
        this.name = name;
        this.age = age;
        this.disease = disease;
    }

    void display() {
        System.out.println(
            "ID: " + id +
            " | Name: " + name +
            " | Age: " + age +
            " | Disease: " + disease
        );
    }
}

class Doctor {
    int id;
    String name;
    String specialization;

    Doctor(int id, String name, String specialization) {
        this.id = id;
        this.name = name;
        this.specialization = specialization;
    }

    void display() {
        System.out.println(
            "ID: " + id +
            " | Doctor: " + name +
            " | Specialization: " + specialization
        );
    }
}

public class HospitalManagementSystem {
    static Scanner sc = new Scanner(System.in);

    static ArrayList<Patient> patients = new ArrayList<>();
    static ArrayList<Doctor> doctors = new ArrayList<>();

    static int patientId = 1;
    static int doctorId = 1;

    public static void main(String[] args) {
        int choice;

        do {
            System.out.println("\n===== HOSPITAL MANAGEMENT SYSTEM =====");
            System.out.println("1. Add Patient");
            System.out.println("2. View Patients");
            System.out.println("3. Add Doctor");
            System.out.println("4. View Doctors");
            System.out.println("5. Book Appointment");
            System.out.println("6. Generate Bill");
            System.out.println("7. Exit");
            System.out.print("Enter your choice: ");

            choice = readInt();

            switch (choice) {
                case 1:
                    addPatient();
                    break;
                case 2:
                    viewPatients();
                    break;
                case 3:
                    addDoctor();
                    break;
                case 4:
                    viewDoctors();
                    break;
                case 5:
                    bookAppointment();
                    break;
                case 6:
                    generateBill();
                    break;
                case 7:
                    System.out.println("Thank you for using the system!");
                    break;
                default:
                    System.out.println("Invalid choice. Try again.");
            }
        } while (choice != 7);

        sc.close();
    }

    static int readInt() {
        while (!sc.hasNextInt()) {
            System.out.print("Enter a valid number: ");
            sc.next();
        }
        int value = sc.nextInt();
        sc.nextLine();
        return value;
    }

    static void addPatient() {
        System.out.print("Enter patient name: ");
        String name = sc.nextLine();

        System.out.print("Enter patient age: ");
        int age = readInt();

        System.out.print("Enter disease: ");
        String disease = sc.nextLine();

        patients.add(new Patient(patientId++, name, age, disease));
        System.out.println("Patient added successfully!");
    }

    static void viewPatients() {
        System.out.println("\n--- Patient List ---");

        if (patients.isEmpty()) {
            System.out.println("No patients found.");
            return;
        }

        for (Patient p : patients) {
            p.display();
        }
    }

    static void addDoctor() {
        System.out.print("Enter doctor name: ");
        String name = sc.nextLine();

        System.out.print("Enter specialization: ");
        String specialization = sc.nextLine();

        doctors.add(new Doctor(doctorId++, name, specialization));
        System.out.println("Doctor added successfully!");
    }

    static void viewDoctors() {
        System.out.println("\n--- Doctor List ---");

        if (doctors.isEmpty()) {
            System.out.println("No doctors found.");
            return;
        }

        for (Doctor d : doctors) {
            d.display();
        }
    }

    static void bookAppointment() {
        if (patients.isEmpty() || doctors.isEmpty()) {
            System.out.println(
                "Please add at least one patient and one doctor first."
            );
            return;
        }

        viewPatients();
        System.out.print("Enter patient ID: ");
        int pId = readInt();

        Patient selectedPatient = null;

        for (Patient p : patients) {
            if (p.id == pId) {
                selectedPatient = p;
                break;
            }
        }

        if (selectedPatient == null) {
            System.out.println("Patient not found.");
            return;
        }

        viewDoctors();
        System.out.print("Enter doctor ID: ");
        int dId = readInt();

        Doctor selectedDoctor = null;

        for (Doctor d : doctors) {
            if (d.id == dId) {
                selectedDoctor = d;
                break;
            }
        }

        if (selectedDoctor == null) {
            System.out.println("Doctor not found.");
            return;
        }

        System.out.print("Enter appointment date (DD-MM-YYYY): ");
        String date = sc.nextLine();

        System.out.println("\nAppointment Booked Successfully!");
        System.out.println("Patient: " + selectedPatient.name);
        System.out.println("Doctor: " + selectedDoctor.name);
        System.out.println("Date: " + date);
    }

    static void generateBill() {
        if (patients.isEmpty()) {
            System.out.println("No patients available.");
            return;
        }

        viewPatients();
        System.out.print("Enter patient ID: ");
        int id = readInt();

        Patient selectedPatient = null;

        for (Patient p : patients) {
            if (p.id == id) {
                selectedPatient = p;
                break;
            }
        }

        if (selectedPatient == null) {
            System.out.println("Patient not found.");
            return;
        }

        System.out.print("Enter consultation fee (Rs.): ");
        double consultation = readAmount();

        System.out.print("Enter medicine charges (Rs.): ");
        double medicine = readAmount();

        System.out.print("Enter room charges (Rs.): ");
        double room = readAmount();

        double total = consultation + medicine + room;

        System.out.println("\n========== HOSPITAL BILL ==========");
        System.out.println("Patient ID   : " + selectedPatient.id);
        System.out.println("Patient Name : " + selectedPatient.name);
        System.out.printf("Consultation : Rs. %.2f%n", consultation);
        System.out.printf("Medicines    : Rs. %.2f%n", medicine);
        System.out.printf("Room Charges : Rs. %.2f%n", room);
        System.out.println("-----------------------------------");
        System.out.printf("Total Amount : Rs. %.2f%n", total);
        System.out.println("===================================");
    }

    static double readAmount() {
        while (!sc.hasNextDouble()) {
            System.out.print("Enter a valid amount: ");
            sc.next();
        }

        double amount = sc.nextDouble();
        sc.nextLine();

        if (amount < 0) {
            System.out.print("Amount cannot be negative. Enter again: ");
            return readAmount();
        }

        return amount;
    }
}
